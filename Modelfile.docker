FROM /gguf/unsloth.Q4_K_M.gguf

PARAMETER temperature 0.7
PARAMETER top_p 0.9
PARAMETER num_ctx 2048
PARAMETER stop "<turn|>"
PARAMETER stop "<eos>"

TEMPLATE """{{- if .System }}<|turn>system
{{ .System }}<turn|>
{{ end }}{{- range .Messages }}{{- if eq .Role "user" }}<|turn>user
{{ .Content }}<turn|>
{{ else if eq .Role "assistant" }}<|turn>model
{{ .Content }}<turn|>
{{ end }}{{- end }}<|turn>model
"""
