# Unsloth vision backend. Heavy: PyTorch + CUDA + transformers + unsloth.
FROM pytorch/pytorch:2.10.0-cuda12.8-cudnn9-runtime

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PYTORCH_ALLOC_CONF=expandable_segments:True \
    HF_HUB_DISABLE_XET=1 \
    PIP_DEFAULT_TIMEOUT=600 \
    PIP_RETRIES=10

WORKDIR /app

COPY requirements.vision.txt .
RUN pip install --no-cache-dir --break-system-packages -r requirements.vision.txt

COPY vision_server.py .

# Adapter directory is bind-mounted via docker-compose at /adapter.
ENV ADAPTER_PATH=/adapter

EXPOSE 8000

CMD ["uvicorn", "vision_server:app", "--host", "0.0.0.0", "--port", "8000"]
